<UserControl x:Class="SimplySignAuto.App.UI.Views.ApplicationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{Binding PageTitle}">
  <StackPanel Margin="{DynamicResource SpaceLarge}">
    <TextBlock Text="{Binding PageTitle}"
               FontSize="26"
               FontWeight="SemiBold"
               AutomationProperties.Name="{Binding PageTitle}" />
    <TextBlock Text="{Binding Description}"
               Margin="0,5,0,0"
               Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap" />

    <Border Style="{DynamicResource StatusPanelStyle}"
            Margin="0,20,0,0"
            AutomationProperties.Name="{Binding StatusAreaAutomationName}">
      <StackPanel>
        <TextBlock Text="{Binding LanguageLabel}" />
        <ComboBox ItemsSource="{Binding Languages}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="CultureName"
                  SelectedValue="{Binding SelectedCultureName}"
                  Margin="0,8,0,0"
                  Width="240"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="{Binding LanguageLabel}" />
        <Button Content="{Binding SaveButtonText}"
                Click="OnSave"
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                AutomationProperties.Name="{Binding SaveButtonText}" />
        <TextBlock Text="{Binding StatusText}"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding StatusText}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
