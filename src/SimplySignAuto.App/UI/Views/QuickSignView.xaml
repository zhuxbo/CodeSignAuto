<UserControl x:Class="SimplySignAuto.App.UI.Views.QuickSignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:SimplySignAuto.App.UI.Localization"
             AutomationProperties.Name="{localization:UiString QuickSignAutomation}">
  <StackPanel Margin="{DynamicResource SpaceLarge}">
    <TextBlock Text="{localization:UiString QuickSignTitle}"
               FontSize="26"
               FontWeight="SemiBold"
               AutomationProperties.Name="{localization:UiString QuickSignTitle}" />

    <Border Style="{DynamicResource StatusPanelStyle}" Margin="0,20,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedFileDisplayText}"
                     FontWeight="SemiBold"
                     AutomationProperties.Name="{Binding SelectedFileDisplayText}" />
          <TextBlock Text="{Binding SelectedFileDetailsText}"
                     Margin="0,5,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,4,0,0">
          <Button Content="{localization:UiString QuickSignChooseFile}"
                  Click="OnChooseFile"
                  AutomationProperties.Name="{localization:UiString QuickSignChooseFileAutomation}" />
          <Button Content="{localization:UiString ActionClear}"
                  Command="{Binding ClearCommand}"
                  AutomationProperties.Name="{localization:UiString QuickSignClearSelection}" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0"
                    Visibility="{Binding HasInlineStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="{Binding StatusIcon}"
                     Margin="0,0,7,0"
                     AutomationProperties.Name="{localization:UiString QuickSignStatusIcon}" />
          <TextBlock Text="{Binding InlineStatusText}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding InlineStatusText}" />
        </StackPanel>
        <ProgressBar Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Value="{Binding CopyProgressPercent, Mode=OneWay}"
                     Maximum="100"
                     Height="8"
                     Margin="0,10,0,0"
                     Visibility="{Binding IsCopying, Converter={StaticResource BooleanToVisibilityConverter}}"
                     AutomationProperties.Name="{Binding CopyProgressText}" />
      </Grid>
    </Border>

    <Border Style="{DynamicResource StatusPanelStyle}" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock Text="{localization:UiString QuickSignParameters}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{localization:UiString QuickSignParametersDescription}"
                   Margin="0,7,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{localization:UiString SigningCertificate}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding AvailableCertificates}"
                    SelectedItem="{Binding SelectedCertificate}"
                    AutomationProperties.Name="{localization:UiString SelectSigningCertificate}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding CommonName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SerialNumber}"
                             FontFamily="Consolas"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPdfSelection}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{localization:UiString PdfPage}" />
          <TextBox Grid.Column="1" Text="{Binding PdfPage}" AutomationProperties.Name="{localization:UiString PdfPageAutomation}" />
          <TextBlock Grid.Row="1" Text="{localization:UiString PdfSignatureBox}" Margin="0,11,0,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PdfLeft}" Margin="0,8,6,0" AutomationProperties.Name="{localization:UiString PdfLeftAutomation}" />
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PdfBottom}" Margin="0,8,6,0" AutomationProperties.Name="{localization:UiString PdfBottomAutomation}" />
          <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PdfRight}" Margin="0,8,6,0" AutomationProperties.Name="{localization:UiString PdfRightAutomation}" />
          <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding PdfTop}" Margin="0,8,0,0" AutomationProperties.Name="{localization:UiString PdfTopAutomation}" />
          <TextBlock Grid.Row="2" Text="{localization:UiString PdfReason}" Margin="0,11,0,0" />
          <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding PdfReason}" Margin="0,8,0,0" AutomationProperties.Name="{localization:UiString PdfReasonAutomation}" />
          <TextBlock Grid.Row="3" Text="{localization:UiString PdfLocation}" Margin="0,11,0,0" />
          <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding PdfLocation}" Margin="0,8,0,0" AutomationProperties.Name="{localization:UiString PdfLocationAutomation}" />
        </Grid>
      </StackPanel>
    </Border>

    <Button Content="{localization:UiString QuickSignSubmit}"
            Command="{Binding SubmitCommand}"
            HorizontalAlignment="Right"
            Margin="0,14,0,0"
            AutomationProperties.Name="{localization:UiString QuickSignSubmitAutomation}" />
  </StackPanel>
</UserControl>
