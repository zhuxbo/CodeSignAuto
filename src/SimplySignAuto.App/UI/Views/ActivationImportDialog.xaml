<Window x:Class="SimplySignAuto.App.UI.Views.ActivationImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入 Certum 激活内容"
        Width="560"
        Height="260"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ShellBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        Closed="OnClosed"
        AutomationProperties.Name="导入 Certum 激活内容">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Certum 激活内容"
               FontSize="20"
               FontWeight="SemiBold" />
    <TextBox x:Name="SecretInput"
             Grid.Row="1"
             Margin="0,14,0,0"
             Text="{Binding OtpauthInput, UpdateSourceTrigger=PropertyChanged}"
             SpellCheck.IsEnabled="False"
             AutomationProperties.Name="Certum 激活内容"
             AutomationProperties.HelpText="粘贴本次合成或真实激活内容；关闭后立即清空" />
    <TextBlock Grid.Row="2"
               x:Name="SaveStatus"
               Margin="0,10,0,0"
               Text="内容仅用于当前用户受保护存储；成功、取消或失败都会清空输入。"
               Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap"
               AutomationProperties.Name="激活内容保存状态" />
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              Content="取消"
              IsCancel="True"
              Click="OnCancel"
              AutomationProperties.Name="取消导入激活内容" />
      <Button x:Name="SaveButton"
              Content="验证并保存"
              IsDefault="True"
              Click="OnSave"
              AutomationProperties.Name="验证并保存 Certum 激活内容" />
    </StackPanel>
  </Grid>
</Window>
