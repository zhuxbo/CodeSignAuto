<Window x:Class="SimplySignAuto.App.UI.Views.ServiceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改服务设置"
        Width="620"
        Height="520"
        MinWidth="560"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ShellBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="OnClosing"
        Closed="OnClosed"
        AutomationProperties.Name="修改服务设置">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="修改服务设置"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock Text="修改会在当前管理员控制台内完成；应用期间服务会重启并重新连接。"
                 Margin="0,6,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap" />

      <Grid Margin="0,20,0,0" IsEnabled="{Binding CanApply}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="HTTP 端口" VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Text="{Binding ListenPortText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="服务监听端口" />

        <TextBlock Grid.Row="1" Text="结果保留小时" Margin="0,12,0,0" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
          <TextBox Text="{Binding RetentionHoursText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="结果保留小时" />
          <TextBlock Text="{Binding RetentionDisplay}"
                     Margin="0,4,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     AutomationProperties.Name="结果保留说明" />
        </StackPanel>

        <CheckBox Grid.Row="2" Grid.Column="1"
                  Margin="0,14,0,0"
                  IsChecked="{Binding RotateToken}"
                  Content="轮换 API Token"
                  AutomationProperties.Name="轮换 API Token" />
      </Grid>

      <Border Margin="0,18,0,0"
              Padding="12"
              Background="{DynamicResource SelectionBrush}"
              CornerRadius="8">
        <StackPanel>
          <TextBlock Text="{Binding StateText}"
                     FontWeight="SemiBold"
                     AutomationProperties.Name="服务设置修改状态" />
          <TextBlock Text="{Binding ErrorCode}"
                     Margin="0,5,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     AutomationProperties.Name="{Binding ErrorCode}" />
        </StackPanel>
      </Border>

      <Border Margin="0,14,0,0" Padding="12" CornerRadius="8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasOneTimeApiToken}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="一次性 API Token"
                     FontWeight="SemiBold" />
          <TextBlock Text="此值只显示一次。复制并安全保存后，请明确确认。"
                     Margin="0,5,0,0"
                     TextWrapping="Wrap" />
          <TextBox Text="{Binding OneTimeApiToken, Mode=OneWay}"
                   Margin="0,10,0,0"
                   IsReadOnly="True"
                   FontFamily="Consolas"
                   AutomationProperties.Name="一次性 API Token" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="复制"
                    Click="OnCopyToken"
                    AutomationProperties.Name="复制一次性 API Token" />
            <Button Content="我已安全保存"
                    Click="OnAcknowledgeToken"
                    AutomationProperties.Name="确认已安全保存一次性 API Token" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="关闭"
                IsEnabled="{Binding CanClose}"
                Click="OnClose"
                AutomationProperties.Name="关闭服务设置修改" />
        <Button Content="应用"
                IsDefault="True"
                IsEnabled="{Binding CanApply}"
                Click="OnApply"
                AutomationProperties.Name="应用服务设置修改" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
