<Window x:Class="SimplySignAuto.App.UI.Views.ServiceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:SimplySignAuto.App.UI.Localization"
        Title="{localization:UiString ServiceSettingsEditTitle}"
        Width="620"
        Height="520"
        MinWidth="560"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ShellBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="OnClosing"
        Closed="OnClosed"
        AutomationProperties.Name="{localization:UiString ServiceSettingsEditTitle}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="{localization:UiString ServiceSettingsEditTitle}"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock Text="{localization:UiString ServiceSettingsEditDescription}"
                 Margin="0,6,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap" />

      <Grid Margin="0,20,0,0" IsEnabled="{Binding CanApply}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{localization:UiString ServiceSettingsHttpPort}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Text="{Binding ListenPortText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{localization:UiString ServiceSettingsListenPort}" />

        <TextBlock Grid.Row="1" Text="{localization:UiString ServiceSettingsRetentionHours}" Margin="0,12,0,0" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
          <TextBox Text="{Binding RetentionHoursText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{localization:UiString ServiceSettingsRetentionHours}" />
          <TextBlock Text="{Binding RetentionDisplay}"
                     Margin="0,4,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     AutomationProperties.Name="{localization:UiString ServiceSettingsRetentionDescription}" />
        </StackPanel>

        <CheckBox Grid.Row="2" Grid.Column="1"
                  Margin="0,14,0,0"
                  IsChecked="{Binding RotateToken}"
                  Content="{localization:UiString ServiceSettingsRotateToken}"
                  AutomationProperties.Name="{localization:UiString ServiceSettingsRotateToken}" />
      </Grid>

      <Border Margin="0,18,0,0"
              Padding="12"
              Background="{DynamicResource SelectionBrush}"
              CornerRadius="8">
        <StackPanel>
          <TextBlock Text="{Binding StateText}"
                     FontWeight="SemiBold"
                     AutomationProperties.Name="{localization:UiString ServiceSettingsEditStatus}" />
          <TextBlock Text="{Binding ErrorCode}"
                     Margin="0,5,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     AutomationProperties.Name="{Binding ErrorCode}" />
        </StackPanel>
      </Border>

      <Border Margin="0,14,0,0" Padding="12" CornerRadius="8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasOneTimeApiToken}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="{localization:UiString ServiceSettingsOneTimeToken}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{localization:UiString ServiceSettingsOneTimeTokenNotice}"
                     Margin="0,5,0,0"
                     TextWrapping="Wrap" />
          <TextBox Text="{Binding OneTimeApiToken, Mode=OneWay}"
                   Margin="0,10,0,0"
                   IsReadOnly="True"
                   FontFamily="Consolas"
                   AutomationProperties.Name="{localization:UiString ServiceSettingsOneTimeToken}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{localization:UiString ActionCopy}"
                    Click="OnCopyToken"
                    AutomationProperties.Name="{localization:UiString ServiceSettingsCopyToken}" />
            <Button Content="{localization:UiString ServiceSettingsAcknowledge}"
                    Click="OnAcknowledgeToken"
                    AutomationProperties.Name="{localization:UiString ServiceSettingsAcknowledgeAutomation}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="{localization:UiString ActionClose}"
                IsEnabled="{Binding CanClose}"
                Click="OnClose"
                AutomationProperties.Name="{localization:UiString ServiceSettingsCloseAutomation}" />
        <Button Content="{localization:UiString ActionApply}"
                IsDefault="True"
                IsEnabled="{Binding CanApply}"
                Click="OnApply"
                AutomationProperties.Name="{localization:UiString ServiceSettingsApplyAutomation}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
