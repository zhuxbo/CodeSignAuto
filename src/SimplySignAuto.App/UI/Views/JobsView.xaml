<UserControl x:Class="SimplySignAuto.App.UI.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:SimplySignAuto.App.UI.Localization"
             AutomationProperties.Name="{localization:UiString JobsAutomation}"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <StackPanel Margin="{DynamicResource SpaceLarge}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{localization:UiString JobsTitle}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="{localization:UiString JobsTitle}" />
        <TextBlock Text="{localization:UiString JobsDescription}"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="{localization:UiString ActionRefresh}"
              Click="OnRefresh"
              VerticalAlignment="Bottom"
              AutomationProperties.Name="{localization:UiString JobsRefreshAutomation}" />
    </Grid>

    <Border Style="{DynamicResource StatusPanelStyle}"
            Margin="0,20,0,0"
            AutomationProperties.Name="{localization:UiString JobsStatusArea}">
      <StackPanel>
        <TextBlock Text="{localization:UiString JobsLoading}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                   AutomationProperties.Name="{localization:UiString JobsLoading}" />
        <TextBlock Text="{Binding ErrorCode}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   AutomationProperties.Name="{Binding ErrorCode}" />
        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="0,11">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding StateIcon}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding StateText}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding OriginalName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{Binding OriginalName}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock Text="{Binding KindText}" />
                      <TextBlock Text=" · " />
                      <TextBlock Text="{Binding ErrorCode, TargetNullValue={localization:UiString StatusNoError}}" />
                      <TextBlock Text="{localization:UiString JobsCorrelationSeparator}" />
                      <TextBlock Text="{Binding CorrelationId}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Text="{Binding SourceText}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding StateText}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding StateText}" />
                  <Button Grid.Column="4"
                          Content="{localization:UiString JobsSaveCopy}"
                          Tag="{Binding JobId}"
                          IsEnabled="{Binding HasResult}"
                          Click="OnSaveResult"
                          AutomationProperties.Name="{localization:UiString JobsSaveCopyAutomation}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{localization:UiString JobsLoadMore}"
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanLoadMore}"
                Click="OnLoadMore"
                AutomationProperties.Name="{localization:UiString JobsLoadMoreAutomation}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
