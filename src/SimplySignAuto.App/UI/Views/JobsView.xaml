<UserControl x:Class="SimplySignAuto.App.UI.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="签名任务列表"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <StackPanel Margin="{DynamicResource SpaceLarge}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="签名任务"
                   FontSize="26"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="签名任务" />
        <TextBlock Text="查看本机与 CI/API 提交的任务；活动任务优先显示。"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="刷新"
              Click="OnRefresh"
              VerticalAlignment="Bottom"
              AutomationProperties.Name="刷新签名任务" />
    </Grid>

    <Border Style="{DynamicResource StatusPanelStyle}"
            Margin="0,20,0,0"
            AutomationProperties.Name="签名任务状态区">
      <StackPanel>
        <TextBlock Text="任务加载中…"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                   AutomationProperties.Name="任务加载中" />
        <TextBlock Text="{Binding ErrorCode}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   AutomationProperties.Name="{Binding ErrorCode}" />
        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="0,11">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding StateIcon}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding StateText}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding OriginalName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{Binding OriginalName}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock Text="{Binding KindText}" />
                      <TextBlock Text=" · " />
                      <TextBlock Text="{Binding ErrorCode, TargetNullValue=无错误}" />
                      <TextBlock Text=" · 关联 " />
                      <TextBlock Text="{Binding CorrelationId}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Text="{Binding SourceText}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding StateText}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding StateText}" />
                  <Button Grid.Column="4"
                          Content="保存副本"
                          Tag="{Binding JobId}"
                          IsEnabled="{Binding HasResult}"
                          Click="OnSaveResult"
                          AutomationProperties.Name="保存签名结果副本" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="加载更多"
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanLoadMore}"
                Click="OnLoadMore"
                AutomationProperties.Name="加载更多签名任务" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
