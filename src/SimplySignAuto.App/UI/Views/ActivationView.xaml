<UserControl x:Class="SimplySignAuto.App.UI.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="OnVisibilityChanged"
             Unloaded="OnUnloaded"
             AutomationProperties.Name="激活凭证">
  <StackPanel Margin="{DynamicResource SpaceLarge}">
    <TextBlock Text="激活凭证"
               FontSize="26"
               FontWeight="SemiBold"
               AutomationProperties.Name="激活凭证" />
    <TextBlock Text="保存 Certum otpauth 激活内容，并查看脱敏的 SimplySign 证书状态。"
               Margin="0,5,0,0"
               Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap" />

    <Border Style="{DynamicResource StatusPanelStyle}"
            Margin="0,20,0,0"
            AutomationProperties.Name="激活状态区">
      <StackPanel>
        <TextBlock Text="Certum 激活" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="激活内容仅用于当前用户的 DPAPI 受保护存储；保存后输入会立即清空。"
                   Margin="0,7,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="OpenImportButton"
                  Content="导入激活内容"
                  Click="OnOpenImport"
                  AutomationProperties.Name="导入 Certum 激活内容" />
          <Button Content="清除"
                  IsEnabled="{Binding CanClearOtp}"
                  Click="OnClearOtpAndLogout"
                  Style="{DynamicResource DangerButtonStyle}"
                  AutomationProperties.Name="清除激活凭证" />
        </StackPanel>
        <TextBlock Text="{Binding DisplaySummary}"
                   Margin="0,9,0,0"
                   AutomationProperties.Name="{Binding DisplaySummary}" />
        <TextBlock Text="{Binding ErrorText}"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   AutomationProperties.Name="{Binding ErrorText}" />

        <Border Margin="0,14,0,0"
                Padding="12"
                Background="{DynamicResource SelectionBrush}"
                CornerRadius="8"
                AutomationProperties.Name="其他机器手工登录区">
          <StackPanel>
            <TextBlock Text="其他机器手工登录"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding TotpInstruction}"
                       Margin="0,5,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="用于其他机器人工登录；本机按需登录无需显示" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="生成当前6位码"
                      Click="OnGenerateTotp"
                      AutomationProperties.Name="生成其他机器手工登录码" />
              <Button Content="复制"
                      IsEnabled="{Binding HasTotpCode}"
                      Click="OnCopyTotp"
                      AutomationProperties.Name="复制其他机器手工登录码" />
            </StackPanel>
            <TextBlock Text="{Binding TotpCode}"
                       Margin="0,10,0,0"
                       FontFamily="Consolas"
                       FontSize="28"
                       FontWeight="SemiBold"
                       AutomationProperties.Name="当前手工登录码" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="剩余 " />
              <Run Text="{Binding TotpRemainingSeconds, Mode=OneWay}" />
              <Run Text=" 秒" />
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Certificates}" Margin="0,14,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{DynamicResource StatusPanelStyle}" Margin="0,0,0,10" AutomationProperties.Name="证书卡片">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="CN" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding CommonName}" FontWeight="SemiBold" />
                <TextBlock Text=" · " />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="序列号" Margin="0,8,0,0" />
              <TextBox Grid.Row="1" Grid.Column="1"
                       Text="{Binding SerialNumber, Mode=OneWay}"
                       IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                       Margin="0,8,0,0" FontFamily="Consolas"
                       PreviewMouseDoubleClick="OnSerialDoubleClick"
                       AutomationProperties.Name="证书序列号" />
              <TextBlock Grid.Row="2" Text="有效期" Margin="0,8,0,0" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ValidityText}" Margin="0,8,0,0" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Style="{DynamicResource StatusPanelStyle}" Margin="0,4,0,0">
      <StackPanel>
        <TextBlock Text="会话" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SessionText}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding HeartbeatText}" Margin="0,5,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Button Content="复制脱敏诊断摘要"
            Margin="0,14,0,0"
            HorizontalAlignment="Left"
            Click="OnCopyDiagnostics"
            AutomationProperties.Name="复制脱敏诊断摘要" />
  </StackPanel>
</UserControl>
