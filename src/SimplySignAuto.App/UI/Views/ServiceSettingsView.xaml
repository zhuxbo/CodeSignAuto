<UserControl x:Class="SimplySignAuto.App.UI.Views.ServiceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="服务设置"
             Loaded="OnLoaded">
  <StackPanel Margin="{DynamicResource SpaceLarge}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="服务设置"
                   FontSize="26"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="服务设置" />
        <TextBlock Text="查看服务摘要并修改 HTTP 监听与保留策略。"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="修改"
              Click="OnEdit"
              VerticalAlignment="Bottom"
              AutomationProperties.Name="修改" />
    </Grid>

    <Border Style="{DynamicResource StatusPanelStyle}"
            Margin="0,20,0,0"
            AutomationProperties.Name="服务设置状态区">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="API 地址" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="http://0.0.0.0:" />
          <TextBlock Text="{Binding Settings.ListenPort}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="最大上传" Margin="0,9,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MaximumUploadText}" Margin="0,9,0,0" />
        <TextBlock Grid.Row="2" Text="结果保留小时" Margin="0,9,0,0" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RetentionText}" Margin="0,9,0,0" />
      </Grid>
    </Border>
    <TextBlock Text="{Binding ErrorCode}"
               Margin="0,10,0,0"
               Foreground="{DynamicResource TextSecondaryBrush}"
               AutomationProperties.Name="{Binding ErrorCode}" />
  </StackPanel>
</UserControl>
