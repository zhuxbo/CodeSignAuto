<Window x:Class="SimplySignAuto.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SimplySignAuto.App.UI"
        xmlns:viewModels="clr-namespace:SimplySignAuto.App.UI.ViewModels"
        xmlns:views="clr-namespace:SimplySignAuto.App.UI.Views"
        Title="SimplySign Auto"
        Icon="Resources/app.ico"
        Width="{x:Static ui:WindowPlacementStore.DefaultWidth}"
        Height="{x:Static ui:WindowPlacementStore.DefaultHeight}"
        MinWidth="{x:Static ui:WindowPlacementStore.MinimumWidth}"
        MinHeight="{x:Static ui:WindowPlacementStore.MinimumHeight}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="OnClosing">
  <Window.Resources>
    <DataTemplate DataType="{x:Type viewModels:OverviewViewModel}">
      <views:OverviewView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:QuickSignViewModel}">
      <views:QuickSignView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:JobsViewModel}">
      <views:JobsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:ActivationViewModel}">
      <views:ActivationView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:ServiceSettingsViewModel}">
      <views:ServiceSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:ApplicationSettingsViewModel}">
      <views:ApplicationSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:NavigationPage}">
      <Grid>
        <ContentPresenter Content="{Binding Content}" />
        <StackPanel Margin="{DynamicResource SpaceLarge}">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Content}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{Binding Title}"
                     FontSize="26"
                     FontWeight="SemiBold"
                     AutomationProperties.Name="{Binding Title}" />
          <Border Style="{DynamicResource StatusPanelStyle}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="○ 功能准备中"
                         FontWeight="SemiBold"
                         AutomationProperties.Name="功能准备中" />
              <TextBlock Text="{Binding PlaceholderText}"
                         Margin="0,8,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="86" />
          <RowDefinition Height="*" />
          <RowDefinition Height="54" />
        </Grid.RowDefinitions>
        <StackPanel Margin="20,18,12,10">
          <TextBlock Text="SimplySign"
                     FontSize="20"
                     FontWeight="Bold" />
          <TextBlock Text="自动签名管理"
                     Margin="0,3,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <ListBox x:Name="NavigationList"
                 Grid.Row="1"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding CurrentPage}"
                 AutomationProperties.Name="主导航">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}"
                           Width="20"
                           Height="20"
                           FontFamily="Segoe UI Symbol"
                           FontSize="14"
                           LineHeight="20"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="{Binding FooterVersionText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   AutomationProperties.Name="产品版本" />
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="FixedHeader"
              Grid.Row="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="22,0">
        <Grid>
          <TextBlock Text="管理控制台"
                     VerticalAlignment="Center"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <Border HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Style="{DynamicResource CompactStatusPanelStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding OverallStatusIcon}"
                         Margin="0,0,7,0"
                         AutomationProperties.Name="状态图标" />
              <TextBlock Text="{Binding OverallStatusText}"
                         AutomationProperties.Name="{Binding OverallStatusAutomationName}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer x:Name="PageContentScroller"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="页面内容">
        <ContentControl Content="{Binding CurrentPage}" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
