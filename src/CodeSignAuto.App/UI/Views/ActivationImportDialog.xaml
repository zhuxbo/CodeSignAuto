<Window x:Class="CodeSignAuto.App.UI.Views.ActivationImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:CodeSignAuto.App.UI.Localization"
        Title="{localization:UiString ActivationImportTitle}"
        Width="560"
        MinHeight="260"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ShellBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        Closed="OnClosed"
        AutomationProperties.Name="{localization:UiString ActivationImportTitle}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{localization:UiString ActivationImportContent}"
               FontSize="20"
               FontWeight="SemiBold" />
    <TextBox x:Name="SecretInput"
             Grid.Row="1"
             Margin="0,14,0,0"
             Text="{Binding OtpauthInput, UpdateSourceTrigger=PropertyChanged}"
             SpellCheck.IsEnabled="False"
             AutomationProperties.Name="{localization:UiString ActivationImportContent}"
             AutomationProperties.HelpText="{localization:UiString ActivationImportHelp}" />
    <StackPanel Grid.Row="2" Margin="0,10,0,10">
      <TextBlock x:Name="SaveStatus"
                 Text="{localization:UiString ActivationImportStorageNotice}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="{localization:UiString ActivationImportStatus}" />
      <TextBlock Text="{Binding ErrorText}"
                 Margin="0,5,0,0"
                 Foreground="{DynamicResource ErrorBrush}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="{Binding ErrorText}"
                 AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              Content="{localization:UiString ActionCancel}"
              IsCancel="True"
              Click="OnCancel"
              AutomationProperties.Name="{localization:UiString ActivationImportCancelAutomation}" />
      <Button x:Name="SaveButton"
              Content="{localization:UiString ActivationValidateAndSave}"
              IsDefault="True"
              Click="OnSave"
              AutomationProperties.Name="{localization:UiString ActivationValidateAndSaveAutomation}" />
    </StackPanel>
  </Grid>
</Window>
